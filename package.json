{
    "name": "coursehunters-course-list-browser",
    "version": "0.2.0",
    "description": "Browse course lessons from coursehunter.net and export download and rename files",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "tsc": "tsc -w --project tsconfig.app.json",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "check:tw": "node scripts/check-tailwind-class-order.mjs",
        "check:tw:fix": "node scripts/check-tailwind-class-order.mjs --fix",
        "to-npm": "pnpm build && gh-pages -d dist"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "cheerio": "1.2.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "jotai": "^3.0.2",
        "jotai-family": "1.1.0",
        "js-file-downloader": "1.1.25",
        "lucide-react": "1.74.0",
        "motion": "14.14.0",
        "next-themes": "0.4.6",
        "path-browserify": "1.0.1",
        "radix-ui": "1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-resizable-panels": "4.24.0",
        "react-use": "^17.6.1",
        "sonner": "2.0.8",
        "tailwind-merge": "3.7.0",
        "tw-animate-css": "1.4.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/path-browserify": "1.0.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "shadcn": "4.23.0",
        "tailwindcss": "^4.3.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
